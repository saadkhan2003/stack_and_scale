# Trivy ignore file for CVEs in the node:24.18.0-bookworm-slim base image.
# These are in Node.js bundled npm packages and Debian OS packages that we
# cannot control without changing the base image.  All are either not
# exploitable in our Node.js runtime or have no available fix yet.

# --- npm bundled packages (inside /usr/local/lib/node_modules/npm) ---
# tar — path traversal / DoS in npm's bundled tar
CVE-2026-59873
CVE-2026-59874
CVE-2026-53655
# brace-expansion — ReDoS in npm's bundled brace-expansion
CVE-2026-13149
CVE-2026-14257
# undici — HTTP/2 issues in npm's bundled undici
CVE-2026-12151

# --- Debian OS packages (perl, util-linux, etc.) ---
# perl-base — not used by Node.js runtime; no fix available in bookworm
CVE-2026-12087
CVE-2026-48959
CVE-2026-48962
CVE-2026-7010
CVE-2026-13221
CVE-2026-42496
CVE-2026-8376
CVE-2026-42497
CVE-2026-57432
CVE-2026-57433
CVE-2026-9538
# systemd / libsystemd0 / libudev1 — systemd-homed not running in container; no fix in bookworm
CVE-2026-16742
# util-linux / bsdutils — mount/blkid not used in container
CVE-2022-0563
CVE-2026-53613
CVE-2026-53615
# libacl1
CVE-2026-54369
# ncurses — terminal libs not used in Node.js container
CVE-2025-69720
# gzip — not exploitable in container context
CVE-2026-41992
# zlib1g — upstream will_not_fix; not exploitable via Node.js
CVE-2023-45853
# libgcrypt20
CVE-2024-2236
# old perl/gnutls/gcc CVEs that remain in bookworm without an upgrade
CVE-2011-4116
CVE-2022-27943
CVE-2011-3389

# --- Go stdlib CVEs found in esbuild gobinary (dev-only, excluded by pnpm deploy --prod) ---
CVE-2025-68121
CVE-2026-56858
CVE-2026-56859
CVE-2026-56860
CVE-2026-56862
