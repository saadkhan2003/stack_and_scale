# Copy this file to .env.local for local development.
# Never commit real credentials or production values.
NODE_ENV=development
DATABASE_URL=postgresql://stack_and_scale:local-development-only@127.0.0.1:5433/stack_and_scale
PAYLOAD_SECRET=local-development-only-secret
CMS_DATABASE_URL=postgresql://stack_and_scale:local-development-only@127.0.0.1:5433/stack_and_scale
CMS_PUBLIC_URL=http://127.0.0.1:3200
NEXT_PUBLIC_CMS_PUBLIC_URL=http://127.0.0.1:3200
WEB_PUBLIC_URL=http://127.0.0.1:3100
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3100
# Set only after a self-hosted Umami instance and privacy review are approved.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Set a unique local value before using CMS preview mode.
CMS_PREVIEW_SECRET=local-preview-only-secret
