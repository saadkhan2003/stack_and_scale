# Copy this file to .env.local for local development.
# Never commit real credentials or production values.
NODE_ENV=development
DATABASE_URL=postgresql://stack_and_scale:local-development-only@127.0.0.1:5433/stack_and_scale
PAYLOAD_SECRET=local-development-only-secret
CMS_DATABASE_URL=postgresql://stack_and_scale:local-development-only@127.0.0.1:5433/stack_and_scale
CMS_PUBLIC_URL=http://127.0.0.1:3200
NEXT_PUBLIC_CMS_PUBLIC_URL=http://127.0.0.1:3200
WEB_PUBLIC_URL=http://127.0.0.1:3100
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3100
# Set only after a self-hosted Umami instance and privacy review are approved.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
API_PUBLIC_URL=http://127.0.0.1:3100
# Digits only; leave empty until the approved business WhatsApp number is available.
NEXT_PUBLIC_WHATSAPP_BUSINESS_NUMBER=
# Internal organization whose owner/admin/manager members can access the CRM.
# Leave empty to disable the CRM API until staff access is explicitly configured.
CRM_ORGANIZATION_ID=
# Optional staff notification recipient for lead emails. Required with the email
# sender credentials when production transactional delivery is enabled.
CRM_NOTIFICATION_EMAIL=
RESEND_API_KEY=
TRANSACTIONAL_EMAIL_FROM=
# Development-only JSONL capture file (never use this as a production mailbox).
EMAIL_CAPTURE_PATH=/tmp/stack-and-scale-email-capture.jsonl
# Comma-separated ISO-8601 UTC slots published by the no-cost local calendar adapter.
# Keep empty to accept alternate-time requests only.
DEMO_AVAILABLE_SLOTS=
# Set a unique local value before using CMS preview mode.
CMS_PREVIEW_SECRET=local-preview-only-secret
# E-sign remains disabled until legal, provider, data-location and cost approval.
ESIGN_PROVIDER_ENABLED=false
ESIGN_PROVIDER_APPROVED=false
ESIGN_PROVIDER_CALLBACK_SECRET=
# Local fallback remains the default. Set `s3` only when the production Compose
# storage lane and Docker secrets have been provisioned.
PRIVATE_STORAGE_PROVIDER=local
PRIVATE_STORAGE_ROOT=/tmp/stack-and-scale-private
PRIVATE_STORAGE_MAX_BYTES=25000000
PRIVATE_STORAGE_S3_ENDPOINT=
PRIVATE_STORAGE_S3_REGION=us-east-1
PRIVATE_STORAGE_S3_BUCKET=
PRIVATE_STORAGE_S3_ACCESS_KEY=
PRIVATE_STORAGE_S3_SECRET_KEY=
PRIVATE_STORAGE_S3_FORCE_PATH_STYLE=true
# `clamav` fails closed on an unavailable scanner; `none` preserves local tests.
MALWARE_SCAN_PROVIDER=none
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000
# Documenso stays disabled unless its Compose profile and provider approval gate
# are explicitly activated.
DOCUMENSO_ENABLED=false
DOCUMENSO_PROVIDER_CALLBACK_URL=
