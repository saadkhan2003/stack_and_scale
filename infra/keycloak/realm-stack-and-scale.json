{
  "realm": "stack-and-scale",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": true,
  "sslRequired": "external",
  "roles": {
    "realm": [
      {
        "name": "owner"
      },
      {
        "name": "admin"
      },
      {
        "name": "manager"
      },
      {
        "name": "member"
      }
    ]
  },
  "clients": [
    {
      "clientId": "web",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "rootUrl": "http://localhost:3000",
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": ["basic", "profile", "email", "roles"]
    },
    {
      "clientId": "api",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    }
  ],
  "users": [
    {
      "username": "test-user",
      "enabled": true,
      "email": "test-user@example.local",
      "emailVerified": true,
      "realmRoles": ["member"],
      "credentials": [
        {
          "type": "password",
          "value": "local-development-only",
          "temporary": false
        }
      ],
      "id": "local-e2e-member-sub",
      "requiredActions": []
    }
  ],
  "requiredActions": [
    {
      "alias": "VERIFY_PROFILE",
      "name": "Verify Profile",
      "enabled": false,
      "defaultAction": false
    }
  ]
}
