FROM node:24.18.0-bookworm-slim AS build
WORKDIR /workspace
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/database/package.json packages/database/package.json
COPY packages/storage/package.json packages/storage/package.json
# Restore only the API and its workspace dependency closure, not CMS/browser
# tooling that is irrelevant to this image.
RUN pnpm --filter @stack-and-scale/api... install --frozen-lockfile
COPY . .
RUN pnpm --filter @stack-and-scale/contracts build && pnpm --filter @stack-and-scale/database build && pnpm --filter @stack-and-scale/storage build && pnpm --filter @stack-and-scale/api build
# The runtime image must contain only the API's production dependency closure.
# Copying the entire workspace would ship test tooling and unrelated packages.
RUN pnpm --filter @stack-and-scale/api --prod deploy --legacy /production-app \
    && pnpm --filter @stack-and-scale/storage --prod deploy --legacy /production-storage

FROM node:24.18.0-bookworm-slim AS runtime
WORKDIR /workspace
ENV NODE_ENV=production
RUN groupadd --gid 10001 app \
    && useradd --uid 10001 --gid app --create-home app \
    && rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /opt/yarn-v1.22.22 \
    && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/pnpm
COPY --from=build --chown=app:app /production-app /workspace
# `pnpm deploy --legacy` preserves workspace-package symlinks. Keep the
# compiled packages at those targets so Node can resolve the API's runtime
# imports without shipping their source or development dependencies.
COPY --from=build --chown=app:app /workspace/packages/contracts/package.json /workspace/packages/contracts/package.json
COPY --from=build --chown=app:app /workspace/packages/contracts/dist /workspace/packages/contracts/dist
COPY --from=build --chown=app:app /workspace/packages/database/package.json /workspace/packages/database/package.json
# The promotion step runs database migrations from the API image. Keep only the
# compiled migration runner and SQL files alongside the deployed app closure.
COPY --from=build --chown=app:app /workspace/packages/database/dist /workspace/packages/database/dist
COPY --from=build --chown=app:app /workspace/packages/database/migrations /workspace/packages/database/migrations
# The API resolves this workspace package through the deployed workspace link.
# Copy its production closure too: S3 support imports AWS SDK modules at API
# startup even when the local-storage adapter is selected.
COPY --from=build --chown=app:app /production-storage /workspace/packages/storage
# Fail the image build if a workspace-linked package lacks a production module.
RUN node -e "import('@stack-and-scale/storage')"
USER app
EXPOSE 3100
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD node -e "fetch('http://127.0.0.1:3100/ready').then((r)=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/src/main.js"]
