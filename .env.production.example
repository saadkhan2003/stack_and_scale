# Copy outside the repository as .env.production. Do not commit actual values.
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@postgres:5432/stack_and_scale
POSTGRES_USER=
POSTGRES_PASSWORD=
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=
PAYLOAD_SECRET=
CMS_DATABASE_URL=postgresql://USER:PASSWORD@postgres:5432/stack_and_scale
CMS_PUBLIC_URL=https://cms.example.com
NEXT_PUBLIC_CMS_PUBLIC_URL=https://cms.example.com
WEB_PUBLIC_URL=https://example.com
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_WHATSAPP_BUSINESS_NUMBER=
API_PUBLIC_URL=https://api.example.com
CMS_PREVIEW_SECRET=
STACK_AND_SCALE_OIDC_ISSUER=https://identity.example.com/realms/stack-and-scale
STACK_AND_SCALE_OIDC_AUDIENCE=web
STACK_AND_SCALE_OIDC_CLIENT_ID=web
STACK_AND_SCALE_OIDC_REDIRECT_URI=https://example.com/api/auth/oidc/callback
STACK_AND_SCALE_OIDC_POST_LOGOUT_REDIRECT=https://example.com/
CRM_ORGANIZATION_ID=
CRM_NOTIFICATION_EMAIL=
RESEND_API_KEY=
TRANSACTIONAL_EMAIL_FROM=
DEMO_AVAILABLE_SLOTS=
PUBLIC_DOMAIN=example.com
ACME_EMAIL=operations@example.com
# Supplied by the protected deployment workflow; do not place registry
# credentials in this file.
IMAGE_REGISTRY=ghcr.io/OWNER/LOWERCASE_REPOSITORY
IMAGE_TAG=COMMIT_SHA
# Enable only after the approved adapter, legal review and provider budget gate.
ESIGN_PROVIDER_ENABLED=false
ESIGN_PROVIDER_APPROVED=false
ESIGN_PROVIDER_CALLBACK_SECRET=
# Private S3-compatible storage. In Compose, keys come from the matching
# Docker secrets and must use the *_FILE paths below rather than this file.
PRIVATE_STORAGE_PROVIDER=s3
PRIVATE_STORAGE_S3_ENDPOINT=http://minio:9000
PRIVATE_STORAGE_S3_REGION=us-east-1
PRIVATE_STORAGE_S3_BUCKET=stack-and-scale-private
PRIVATE_STORAGE_S3_ACCESS_KEY_FILE=/run/secrets/minio_api_access_key
PRIVATE_STORAGE_S3_SECRET_KEY_FILE=/run/secrets/minio_api_secret_key
PRIVATE_STORAGE_S3_FORCE_PATH_STYLE=true
PRIVATE_STORAGE_MAX_BYTES=25000000
MALWARE_SCAN_PROVIDER=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000
# Disabled unless `--profile documenso` is passed after the provider/legal gate.
DOCUMENSO_ENABLED=false
DOCUMENSO_IMAGE=documenso/documenso:2.0.0
DOCUMENSO_DATABASE_URL=postgresql://USER:PASSWORD@postgres:5432/documenso
DOCUMENSO_PROVIDER_CALLBACK_URL=https://api.example.com/api/v1/contracts/provider-callback
